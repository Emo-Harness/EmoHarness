{
  "$defs": {
    "AudioEvidence": {
      "additionalProperties": false,
      "description": "Audio cues from the selected perception protocol.\n\nWhen enabled, transcript and language come from Whisper; prosody comes from\nopenSMILE functionals compared with corpus reference statistics. No model\nopinion enters here. Empty transcript means no intelligible speech.",
      "properties": {
        "speech_present": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "description": "None when transcription is disabled; unknown is not silence",
          "title": "Speech Present"
        },
        "transcript": {
          "default": "",
          "title": "Transcript",
          "type": "string"
        },
        "language": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Language"
        },
        "prosody": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Prosody",
          "type": "array"
        }
      },
      "required": [
        "speech_present"
      ],
      "title": "AudioEvidence",
      "type": "object"
    },
    "EvidenceItem": {
      "additionalProperties": false,
      "description": "One citable cue. Reasoning steps may only cite ids that exist in a record.",
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "modality": {
          "enum": [
            "visual",
            "audio",
            "text"
          ],
          "title": "Modality",
          "type": "string"
        },
        "cue": {
          "minLength": 1,
          "title": "Cue",
          "type": "string"
        },
        "segment": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "(start_s, end_s)",
          "title": "Segment"
        }
      },
      "required": [
        "id",
        "modality",
        "cue"
      ],
      "title": "EvidenceItem",
      "type": "object"
    },
    "EvidenceRecord": {
      "additionalProperties": false,
      "description": "The structured record assembled before any label is requested.",
      "properties": {
        "visual": {
          "$ref": "#/$defs/VisualEvidence"
        },
        "audio": {
          "$ref": "#/$defs/AudioEvidence"
        },
        "text": {
          "$ref": "#/$defs/ParsedPrompt"
        },
        "items": {
          "default": [],
          "description": "flattened citable cues",
          "items": {
            "$ref": "#/$defs/EvidenceItem"
          },
          "title": "Items",
          "type": "array"
        }
      },
      "required": [
        "visual",
        "audio",
        "text"
      ],
      "title": "EvidenceRecord",
      "type": "object"
    },
    "Hypothesis": {
      "additionalProperties": false,
      "description": "A candidate label with the evidence ids that support or contradict it.",
      "properties": {
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "support": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Support",
          "type": "array"
        },
        "contradiction": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Contradiction",
          "type": "array"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        }
      },
      "required": [
        "label",
        "confidence"
      ],
      "title": "Hypothesis",
      "type": "object"
    },
    "HypothesisSet": {
      "additionalProperties": false,
      "properties": {
        "coarse": {
          "description": "coarse state, e.g. negative-high-arousal",
          "minLength": 1,
          "title": "Coarse",
          "type": "string"
        },
        "hypotheses": {
          "items": {
            "$ref": "#/$defs/Hypothesis"
          },
          "minItems": 1,
          "title": "Hypotheses",
          "type": "array"
        }
      },
      "required": [
        "coarse",
        "hypotheses"
      ],
      "title": "HypothesisSet",
      "type": "object"
    },
    "ParsedPrompt": {
      "description": "Everything the harness may read from an item's prompt.",
      "properties": {
        "quantifier": {
          "$ref": "#/$defs/Quantifier"
        },
        "noun": {
          "title": "Noun",
          "type": "string"
        },
        "label_set": {
          "items": {
            "type": "string"
          },
          "minItems": 2,
          "title": "Label Set",
          "type": "array"
        }
      },
      "required": [
        "quantifier",
        "noun",
        "label_set"
      ],
      "title": "ParsedPrompt",
      "type": "object"
    },
    "Quantifier": {
      "description": "The three quantifiers the public template uses.",
      "enum": [
        "the most prominent",
        "one or several",
        "multiple"
      ],
      "title": "Quantifier",
      "type": "string"
    },
    "StageTrace": {
      "additionalProperties": false,
      "description": "What one pipeline stage cost. Kept for parse-failure and budget reporting.",
      "properties": {
        "stage": {
          "title": "Stage",
          "type": "string"
        },
        "calls": {
          "minimum": 0,
          "title": "Calls",
          "type": "integer"
        },
        "parse_failures": {
          "minimum": 0,
          "title": "Parse Failures",
          "type": "integer"
        },
        "input_tokens": {
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "output_tokens": {
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "latency_s": {
          "minimum": 0.0,
          "title": "Latency S",
          "type": "number"
        }
      },
      "required": [
        "stage",
        "calls",
        "parse_failures",
        "input_tokens",
        "output_tokens",
        "latency_s"
      ],
      "title": "StageTrace",
      "type": "object"
    },
    "VerificationResult": {
      "additionalProperties": false,
      "description": "Outcome of the verification stage: agreement flag and a ranked hypothesis list.",
      "properties": {
        "modalities_agree": {
          "title": "Modalities Agree",
          "type": "boolean"
        },
        "ranked": {
          "items": {
            "$ref": "#/$defs/Hypothesis"
          },
          "minItems": 1,
          "title": "Ranked",
          "type": "array"
        },
        "notes": {
          "default": "",
          "title": "Notes",
          "type": "string"
        }
      },
      "required": [
        "modalities_agree",
        "ranked"
      ],
      "title": "VerificationResult",
      "type": "object"
    },
    "VisualEvidence": {
      "additionalProperties": false,
      "properties": {
        "face": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Face",
          "type": "array"
        },
        "body": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Body",
          "type": "array"
        },
        "scene": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Scene",
          "type": "array"
        },
        "temporal_change": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Temporal Change"
        }
      },
      "title": "VisualEvidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Final per-item result: emitted labels, the five steps, and the full response text.",
  "properties": {
    "example_id": {
      "title": "Example Id",
      "type": "string"
    },
    "labels": {
      "description": "verbatim from the candidate list",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Labels",
      "type": "array"
    },
    "steps": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Steps",
      "type": "array"
    },
    "response_text": {
      "description": "what the official judge receives",
      "minLength": 1,
      "title": "Response Text",
      "type": "string"
    },
    "evidence": {
      "$ref": "#/$defs/EvidenceRecord"
    },
    "hypotheses": {
      "$ref": "#/$defs/HypothesisSet"
    },
    "verification": {
      "$ref": "#/$defs/VerificationResult"
    },
    "traces": {
      "default": [],
      "items": {
        "$ref": "#/$defs/StageTrace"
      },
      "title": "Traces",
      "type": "array"
    },
    "fallback_used": {
      "default": false,
      "title": "Fallback Used",
      "type": "boolean"
    }
  },
  "required": [
    "example_id",
    "labels",
    "steps",
    "response_text",
    "evidence",
    "hypotheses",
    "verification"
  ],
  "title": "HarnessOutput",
  "type": "object"
}
